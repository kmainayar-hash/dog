# Dog Influencer Scraper Configuration

# Scraping mode: 'demo' or 'real'
SCRAPER_MODE=demo

# Output file name
OUTPUT_FILE=dog_influencers_by_state.json

# Rate limiting (seconds between requests in real mode)
MIN_DELAY=2
MAX_DELAY=5

# API Keys (if using official APIs in the future)
# INSTAGRAM_API_KEY=your_key_here
# TIKTOK_API_KEY=your_key_here
# YOUTUBE_API_KEY=your_key_here
